{
  "name": "@agentsync/master-test-framework",
  "version": "2.0.0",
  "description": "AgentSync Master Test Automation Framework - Consolidated Professional Services & Playwright Framework",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./bin/cli.js",
    "./generate-page": "./bin/generate-page",
    "./generate-selectors": "./bin/generate-selectors",
    "./bin": "./bin/index.js",
    "./setup": "./bin/setup-client-project.js",
    "./templates": "./templates/basic/framework.config.js",
    "./playwright-config": "./playwright.config.js",
    "./salesforce-config": "./playwright.config.salesforce.js",
    "./global-setup": "./global-setup.js",
    "./utils": "./src/utils/index.js",
    "./utils/accessibility": "./src/utils/accessibility/index.js",
    "./utils/api": "./src/utils/api/index.js",
    "./utils/ci": "./src/utils/ci/index.js",
    "./utils/cli": "./src/utils/cli/index.js",
    "./utils/common": "./src/utils/common/index.js",
    "./utils/core": "./src/utils/core/index.js",
    "./utils/data": "./src/utils/data/index.js",
    "./utils/database": "./src/utils/database/index.js",
    "./utils/generators": "./src/utils/generators/index.js",
    "./utils/git": "./src/utils/git/index.js",
    "./utils/localization": "./src/utils/localization/index.js",
    "./utils/mobile": "./src/utils/mobile/index.js",
    "./utils/performance": "./src/utils/performance/index.js",
    "./utils/plugins": "./src/utils/plugins/index.js",
    "./utils/reporting": "./src/utils/reporting/index.js",
    "./utils/salesforce": "./src/utils/salesforce/index.js",
    "./utils/scheduler": "./src/utils/scheduler/index.js",
    "./utils/security": "./src/utils/security/index.js",
    "./utils/setup": "./src/utils/setup/index.js",
    "./utils/testing": "./src/utils/testing/index.js",
    "./utils/testrail": "./src/utils/testrail/index.js",
    "./utils/visual": "./src/utils/visual/index.js",
    "./utils/visualization": "./src/utils/visualization/index.js",
    "./utils/web": "./src/utils/web/index.js",
    "./utils/xray": "./src/utils/xray/index.js",
    "./fixtures": "./src/fixtures/index.js",
    "./pages": "./src/pages/BasePage.js",
    "./pages/salesforce": "./src/pages/salesforce/BaseSalesforcePage.js",
    "./config": "./src/config/base.config.js",
    "./salesforce": "./src/utils/salesforce/index.js",
    "./tests": "./src/tests/index.js",
    "./examples": "./examples/playwright/run-all-examples.js",
    "./data": "./src/data/test-mapping.json",
    "./dashboard": "./src/dashboard/server.js",
    "./helpers": "./src/helpers/index.js",
    "./templates/basic": "./templates/basic/framework.config.js",
    "./templates/salesforce": "./templates/salesforce/global-setup.js",
    "./locales": "./locales/en.json"
  },
  "bin": {
    "agentsync": "./bin/index.js",
    "agentsync-framework": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "docs",
    "config",
    "scripts",
    "examples",
    "data",
    "locales",
    "index.js",
    "global-setup.js",
    "playwright.config.js",
    "playwright.config.salesforce.js",
    ".env.example",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igautomation/AgentSyncMasterFramework.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "pretest": "node scripts/ensure-reports-dir.js",
    "check-dependencies": "node scripts/check-system-dependencies.js",
    "test": "playwright test",
    "test:e2e": "playwright test src/tests/e2e",
    "test:api": "playwright test src/tests/api",
    "test:ui": "playwright test src/tests/ui",
    "test:accessibility": "playwright test src/tests/accessibility",
    "test:salesforce": "playwright test src/tests/salesforce",
    "test:salesforce:headed": "playwright test src/tests/salesforce --headed",
    "test:salesforce:debug": "playwright test src/tests/salesforce --debug",
    "test:salesforce:ui": "playwright test src/tests/salesforce --ui",
    "setup:reports": "node scripts/ensure-reports-dir.js",
    "setup:salesforce": "node src/tests/salesforce/global-setup.js",
    "setup:client-project": "node bin/setup-client-project.js",
    "setup:dependencies": "node bin/setup-dependencies.js",
    "init": "node bin/index.js init",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "report": "npx playwright show-report",
    "docs:dev": "cd docs-site && npm run start",
    "docs:build": "cd docs-site && npm run build",
    "build": "webpack",
    "prepublishOnly": "npm run build",
    "framework:init": "node bin/cli.js init",
    "sf:token": "node scripts/salesforce/generate-token.js",
    "sf:apex-tests": "node scripts/salesforce/run-apex-tests.js",
    "docker:build": "docker build -t agentsync-master-framework .",
    "docker:run": "docker-compose up",
    "docker:test": "docker-compose -f docker-compose.yml up --build",
    "validate:framework": "node scripts/utils/validate-framework.js",
    "run:all": "node scripts/test-runners/run-all-tests.js",
    "verify:secrets": "node scripts/ci/verify-secrets.js",
    "generate:user-guide": "node scripts/docs-management/generate-user-guide.js",
    "postinstall": "node scripts/check-dependencies.js"
  },
  "keywords": [
    "e2e",
    "api",
    "playwright",
    "accessibility",
    "salesforce",
    "testing",
    "framework",
    "automation",
    "testrail",
    "apex",
    "soql",
    "professional-services"
  ],
  "author": "AgentSync",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.53.2",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "chart.js": "^4.4.0",
    "commander": "^11.1.0",
    "csv-parse": "^5.5.2",
    "dotenv": "^16.6.1",
    "dotenv-safe": "^8.2.0",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "form-data": "^4.0.3",
    "js-yaml": "^4.1.0",
    "jsforce": "^3.9.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.53.2",
    "pngjs": "^7.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "allure-playwright": "^2.9.2",
    "babel-loader": "^9.1.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.18.0",
    "husky": "^8.0.3",
    "ignore-loader": "^0.1.2",
    "lint-staged": "^15.5.0",
    "prettier": "^3.6.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.100.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "@playwright/test": "^1.53.2"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2",
    "chartjs-node-canvas": "^4.1.6"
  }
}